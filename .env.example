# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spareshub"

# Secret used to sign login sessions (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the site, used to build the M-Pesa callback URL
APP_URL="http://localhost:3000"

# ---- M-Pesa (Safaricom Daraja) ----
# "sandbox" or "production"
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# Paybill / till number (sandbox default 174379)
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
# "CustomerPayBillOnline" for paybill, "CustomerBuyGoodsOnline" for till numbers
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Optional override; defaults to ${APP_URL}/api/mpesa/callback. Must be public HTTPS for Safaricom to reach it.
MPESA_CALLBACK_URL=""
# Shared token appended to the callback URL so we can reject forged callbacks
MPESA_CALLBACK_TOKEN="change-me"
# Set to "true" to simulate payments locally without calling Safaricom
MPESA_MOCK="true"

# ---- Courier tracking ----
# Neither Posta Kenya nor Fargo Courier publish an open tracking API. If you obtain
# API access, set these and the matching provider will poll it; otherwise sellers
# post status updates manually and buyers see those.
POSTA_TRACKING_API_URL=""
POSTA_TRACKING_API_KEY=""
FARGO_TRACKING_API_URL=""
FARGO_TRACKING_API_KEY=""

# ---- Escrow, wallet and verification ----
# Markup added to the seller's price. Buyers pay it; SparesHub keeps it when escrow is released
PLATFORM_MARKUP_PERCENT="5"
# What sellers pay by M-Pesa to register (individuals' payment also checks their M-Pesa name)
SELLER_REGISTRATION_FEE_KES="100"
# Where seller ID documents are stored. Must be private and persistent; use object storage in production.
UPLOAD_DIR="./uploads"
# "database" keeps uploads in Postgres instead of UPLOAD_DIR, for serverless hosts without a disk.
STORAGE_DRIVER="disk"

# ---- Business registration checks (Registrar of Companies / BRS) ----
# Sellers' businesses are looked up through Dojah's Kenya KYB API (https://dojah.io). Without these keys,
# moderators check each business by hand on eCitizen and record the search on the store's review page.
DOJAH_APP_ID=""
DOJAH_SECRET_KEY=""
# Use https://sandbox.dojah.io with sandbox keys.
DOJAH_BASE_URL="https://api.dojah.io"
# "true" uses a demo registry that only knows BN-DEMO1234 (Wanjiru Electronics, owner Wanjiru Kamau).
BUSINESS_REGISTRY_MOCK="false"

# Initiator for the Transaction Status API, used to learn an individual seller's M-Pesa name.
MPESA_INITIATOR_NAME=""
# Initiator password encrypted with Safaricom's certificate (generate it on the Daraja portal).
MPESA_SECURITY_CREDENTIAL=""

# ---- SMS notifications (Africa's Talking, optional) ----
# Leave empty to only show notifications on the site. Use AT_USERNAME="sandbox" for testing.
AT_USERNAME=""
AT_API_KEY=""
# Approved alphanumeric sender ID, optional
AT_SENDER_ID=""

# ---- Escrow auto-release ----
# Days after the seller/courier marks a parcel delivered before escrow is released automatically if the
# buyer neither confirms nor disputes. Empty or 0 disables auto-release.
ESCROW_AUTO_RELEASE_DAYS="7"
# Secret for the scheduled job endpoint /api/cron/escrow (send as "Authorization: Bearer <secret>")
CRON_SECRET="change-me"
